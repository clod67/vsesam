؟ ═══════════════════════════════════════════════════════════════
؟  agents.nanch — витрина AI-агентов и сессий в VSESAM.
؟  Показывает: собственные мозги-агенты на nanch, встроенные
؟  поведения, и персистентную сессию (счётчик запусков).
؟ ═══════════════════════════════════════════════════════════════

؟ ─── сессия: сколько раз этот игрок запускал витрину ───
设 runs = 数值(取("runs"))؛
如果 (runs == 空) { runs = 0؛ }
runs = runs + 1؛
记("runs", runs)؛
喊("Привет,", 我(), "— запуск витрины №", runs)؛

؟ ─── мозг-агент «трус»: держит дистанцию от ближайшего врага ───
函 трус(id) {
  设 враг = 近(id)؛
  如果 (враг == 空) { 回؛ }
  如果 (距(id, враг) < 6) {
    ؟ шаг ПРОЧЬ от врага
    设 dx = 0؛
    设 dy = 0؛
    如果 (横(враг) > 横(id)) { dx = -1؛ } 否则 { dx = 1؛ }
    如果 (纵(враг) > 纵(id)) { dy = -1؛ } 否则 { dy = 1؛ }
    动(id, dx, dy)؛
  }
}

؟ ─── мозг-агент «снайпер»: стоит, но добивает подошедших вплотную ───
函 снайпер(id) {
  设 цель = 近(id)؛
  如果 (цель == 空) { 回؛ }
  如果 (距(id, цель) <= 1.5) {
    伤(цель, 3)؛      ؟ спец-атака прямо из мозга
  }
}

؟ игрок под встроенным «умным» мозгом
设 me = 生("player", 24, 10)؛
脑(me, "think")؛

؟ агент-трус слева, агент-снайпер справа
设 t = 代理("agent", 6, 10, трус)؛
标(t, "трус")؛
设 s = 代理("agent", 42, 10, снайпер)؛
标(s, "снайпер")؛

؟ немного монстров на пробу поведений
设 k = 0؛
طالما (k < 5) {
  设 g = 生("goblin", 数(4, 44), 数(2, 18))؛
  脑(g, "seek")؛
  k = k + 1؛
}

喊("агенты расставлены. стражей:", 友数(), "монстров:", 敌数())؛
